{
  "openapi": "3.1.0",
  "info": {
    "title": "GHDL Execution Service",
    "description": "P5A: runs VHDL through GHDL analysis, elaboration and simulation, each stage in its own locked-down Docker container, and returns the result of every stage plus the VCD waveform.",
    "version": "0.1.0"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Home",
        "operationId": "home__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/simulate": {
      "post": {
        "summary": "Simulate",
        "operationId": "simulate_simulate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimulationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulationResult"
                }
              }
            }
          },
          "400": {
            "description": "validation_error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulationResult"
                }
              }
            }
          },
          "500": {
            "description": "internal_error (bug)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulationResult"
                }
              }
            }
          },
          "503": {
            "description": "internal_error: Docker down or image missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulationResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/simulate/vcd": {
      "post": {
        "summary": "Simulate Vcd",
        "description": "Same job as /simulate, but a success returns the waveform as a .vcd\nfile download instead of JSON. Any failure returns the usual JSON result\n(HTTP 422 for VHDL errors and timeouts, since there is no file).",
        "operationId": "simulate_vcd_simulate_vcd_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimulationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The waveform as a .vcd file, ready to open in Surfer",
            "content": {
              "text/plain": {}
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulationResult"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulationResult"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulationResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SimulationRequest": {
        "properties": {
          "files": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/VhdlFile"
                },
                "type": "array",
                "minItems": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Files"
          },
          "top": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Top",
            "examples": [
              "and_gate_tb"
            ]
          },
          "stop_time": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stop Time",
            "examples": [
              "100ns"
            ]
          },
          "filename": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Filename"
          },
          "vhdl_source": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Vhdl Source"
          },
          "top_entity": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Top Entity"
          }
        },
        "type": "object",
        "title": "SimulationRequest",
        "description": "A job: the VHDL files, the testbench to run, and how long to simulate.\n\nPreferred form:  {\"files\": [{\"name\", \"content\"}, ...], \"top\", \"stop_time\"}\nThe single-file form from Milestone 2 is still accepted:\n                 {\"filename\", \"vhdl_source\", \"top_entity\"}"
      },
      "SimulationResult": {
        "properties": {
          "job_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "stage": {
            "type": "string",
            "title": "Stage"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "stages": {
            "items": {
              "$ref": "#/components/schemas/StageResult"
            },
            "type": "array",
            "title": "Stages"
          },
          "vcd": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vcd"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status",
          "stage",
          "error",
          "message",
          "stages",
          "vcd"
        ],
        "title": "SimulationResult",
        "description": "The result of a job, as returned by POST /simulate."
      },
      "StageResult": {
        "properties": {
          "stage": {
            "type": "string",
            "title": "Stage"
          },
          "command": {
            "type": "string",
            "title": "Command"
          },
          "exit_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exit Code"
          },
          "output": {
            "type": "string",
            "title": "Output"
          },
          "duration_s": {
            "type": "number",
            "title": "Duration S"
          },
          "timed_out": {
            "type": "boolean",
            "title": "Timed Out"
          },
          "oom_killed": {
            "type": "boolean",
            "title": "Oom Killed"
          }
        },
        "type": "object",
        "required": [
          "stage",
          "command",
          "exit_code",
          "output",
          "duration_s",
          "timed_out",
          "oom_killed"
        ],
        "title": "StageResult",
        "description": "What happened in one GHDL stage (analysis, elaboration or simulation)."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VhdlFile": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "examples": [
              "and_gate.vhd"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "name",
          "content"
        ],
        "title": "VhdlFile",
        "description": "One VHDL source file sent by the client."
      }
    }
  }
}
